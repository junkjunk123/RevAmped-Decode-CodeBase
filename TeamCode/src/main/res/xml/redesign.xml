<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Expansion Hub 2" port="2">
            <goBILDA5202SeriesMotor name="vslideMotorLeft" port="0"/>
            <goBILDA5202SeriesMotor name="vslideMotorRight" port="1"/>
            <goBILDA5202SeriesMotor name="intake" port="2"/>
            <goBILDA5202SeriesMotor name="hslides" port="3"/>
            <Servo name="pto" port="0"/>
            <Servo name="slideHang" port="1"/>
            <Servo name="depoArm" port="2"/>
            <Servo name="depoWrist" port="3"/>
            <Servo name="depoTilt" port="4"/>
            <Servo name="depoTurret" port="5"/>
            <AnalogInput name="armVoltage" port="0"/>
            <DigitalDevice name="vswitch" port="0"/>
        </LynxModule>
        <LynxModule name="Control Hub" port="173">
            <goBILDA5202SeriesMotor name="motor_lb" port="0"/> <!--y-encoder-->
            <goBILDA5202SeriesMotor name="motor_rf" port="1"/>
            <goBILDA5202SeriesMotor name="motor_lf" port="2"/>
            <goBILDA5202SeriesMotor name="motor_rb" port="3"/> <!--x-encoder-->
            <Servo name="hlock" port="0"/>
            <Servo name="intakeTilt" port="1"/>
            <Servo name="intakeTrapdoor" port="2"/>
            <Servo name="intakeArm" port="3"/>
            <Servo name="depoClaw" port="5"/>
            <DigitalDevice name="hswitch" port="2"/>
            <goBILDAPinpoint name="pinpoint" port="0" bus="1"/>
            <RevColorSensorV3 name="Color" port="0" bus="2"/>
            <AnalogInput name="intakeArmVoltage" port="3"/>
            <AnalogInput name="ultrasonic" port="2"/>
        </LynxModule>
    </LynxUsbDevice>
    <EthernetDevice serialNumber="EthernetOverUsb:eth0:172.29.0.21" name="limelight" port="0" ipAddress="172.29.0.1" />
</Robot>