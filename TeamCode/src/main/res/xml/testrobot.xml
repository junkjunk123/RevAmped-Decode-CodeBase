<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Expansion Hub" port="2">
            <goBILDA5202SeriesMotor name="hslides" port="0"/>
            <goBILDA5202SeriesMotor name="vslides" port="1"/>
            <goBILDA5202SeriesMotor name="vslides2" port="2"/>
        </LynxModule>
        <ServoHub name="Intake Servo Hub" port="4">
            <Servo name="intakeWrist" port="0"/>
            <Servo name="intakeArm" port="1"/>
            <Servo name="intakeClaw" port="2"/>
            <Servo name="hlock" port="3"/>
            <Servo name="intakeTurret" port="4"/>
            <Servo name="intakeTilt" port="5"/>
